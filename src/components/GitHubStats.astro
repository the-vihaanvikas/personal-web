---
/**
 * Live GitHub statistics — fetches from the GitHub API on the client,
 * caches in localStorage, renders skeletons while loading, and degrades
 * gracefully when the username is still a placeholder.
 *
 * Optional: set PUBLIC_GITHUB_TOKEN in .env for the contribution heatmap
 * (GraphQL) — total contributions, current/longest streak.
 */

import { site, hasGithubUsername } from '../config/site';
import Icon from './Icon.astro';

const username = site.github.username;
const demoUsername = site.github.demoUsername;
const hasToken = Boolean(import.meta.env.PUBLIC_GITHUB_TOKEN);
---

<section class="gh" aria-label="GitHub statistics">
  <div id="gh-root" data-username={username} data-demo={demoUsername} data-has-token={String(hasToken)}></div>
</section>

<style>
  .gh {
    display: grid;
    gap: 20px;
  }

  .gh-state {
    padding: clamp(24px, 4vw, 44px);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .gh-state__orb {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--grad-accent);
    box-shadow: 0 14px 34px -10px color-mix(in srgb, var(--accent) 60%, transparent);
    margin-bottom: 6px;
  }

  .gh-state h3 {
    font-size: 1.25rem;
  }

  .gh-state p {
    color: var(--text-2);
    font-size: 0.94rem;
    max-width: 46ch;
  }

  .gh-state code {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    padding: 3px 9px;
    border-radius: 7px;
    background: var(--code-bg);
    border: 1px solid var(--glass-border-2);
  }

  .gh-profile {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 24px;
    flex-wrap: wrap;
  }

  .gh-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    flex: none;
  }

  .gh-avatar-wrap {
    position: relative;
    flex: none;
  }

  .gh-avatar-wrap::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    z-index: -1;
  }

  .gh-id {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .gh-id h3 {
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .gh-id .gh-login {
    color: var(--text-3);
    font-weight: 520;
    font-size: 0.95rem;
  }

  .gh-id .gh-bio {
    color: var(--text-2);
    font-size: 0.92rem;
    max-width: 52ch;
  }

  .gh-id .gh-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .gh-metrics {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }

  .gh-metric {
    padding: 18px 16px;
    display: grid;
    gap: 2px;
    align-content: start;
  }

  .gh-metric .value {
    font-size: 1.5rem;
    font-weight: 640;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .gh-metric .label {
    font-size: 0.78rem;
    color: var(--text-3);
    font-weight: 520;
  }

  .gh-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .gh-panel {
    padding: 24px;
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .gh-panel h4 {
    font-size: 1.02rem;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .gh-panel h4 svg {
    color: var(--accent);
  }

  .gh-repo {
    display: grid;
    gap: 4px;
    padding: 13px 10px;
    border-radius: var(--r-md);
    transition: background var(--dur-fast) ease;
  }

  .gh-repo:hover {
    background: var(--glass-bg-2);
  }

  .gh-repo__top {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .gh-repo__name {
    font-weight: 590;
    font-size: 0.94rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gh-repo__name:hover {
    color: var(--accent);
  }

  .gh-repo__desc {
    font-size: 0.84rem;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gh-repo__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .gh-repo__meta span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .gh-event {
    display: flex;
    gap: 13px;
    padding: 11px 10px;
    border-radius: var(--r-md);
    align-items: flex-start;
    transition: background var(--dur-fast) ease;
  }

  .gh-event:hover {
    background: var(--glass-bg-2);
  }

  .gh-event__icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    background: var(--glass-bg-2);
    border: 1px solid var(--glass-border-2);
    color: var(--text-2);
  }

  .gh-event__body {
    min-width: 0;
  }

  .gh-event__text {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.45;
  }

  .gh-event__text b {
    color: var(--text-1);
    font-weight: 590;
  }

  .gh-event__time {
    font-size: 0.76rem;
    color: var(--text-3);
  }

  .gh-empty-events {
    font-size: 0.88rem;
    color: var(--text-3);
    padding: 12px 10px;
  }

  .gh-heatmap {
    display: grid;
    grid-template-rows: repeat(7, 10px);
    grid-auto-flow: column;
    gap: 2.5px;
    overflow-x: auto;
    padding-bottom: 8px;
    width: fit-content;
    max-width: 100%;
  }

  .heat-cell {
    width: 10px;
    height: 10px;
    border-radius: 2.5px;
    background: var(--heat-0, var(--skeleton));
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .heat-cell:hover {
    transform: scale(1.45);
  }

  .heat-1 { background: var(--heat-1); }
  .heat-2 { background: var(--heat-2); }
  .heat-3 { background: var(--heat-3); }
  .heat-4 { background: var(--heat-4); }

  .gh-streaks {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .gh-lang {
    display: grid;
    gap: 7px;
  }

  .gh-lang__row {
    display: grid;
    grid-template-columns: 110px 1fr 44px;
    align-items: center;
    gap: 12px;
    font-size: 0.84rem;
  }

  .gh-lang__name {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
  }

  .gh-lang__bar {
    height: 6px;
    border-radius: 99px;
    background: var(--skeleton);
    overflow: hidden;
  }

  .gh-lang__bar i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--grad-accent);
    transition: width 1s var(--ease-out);
  }

  .gh-lang__count {
    text-align: right;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .gh-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 0 4px;
    font-size: 0.8rem;
    color: var(--text-3);
  }

  .gh-skeleton {
    display: grid;
    gap: 16px;
  }

  .gh-skel-row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }

  .gh-skel-row .skeleton {
    height: 92px;
  }

  @media (max-width: 1000px) {
    .gh-metrics,
    .gh-skel-row {
      grid-template-columns: repeat(3, 1fr);
    }

    .gh-panels {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .gh-metrics,
    .gh-skel-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .gh-profile {
      justify-content: center;
      text-align: center;
    }

    .gh-id .gh-meta,
    .gh-id h3 {
      justify-content: center;
    }
  }
</style>

<script>
  import { fetchGitHubData, eventIcon, languageColor, type GithubData } from '../lib/github';
  import { formatNumber, formatCompact, timeAgo, formatDateMedium } from '../lib/format';
  import { ICON_PATHS } from '../scripts/icons';

  const root = document.getElementById('gh-root') as HTMLElement | null;
  const username = root?.dataset.username ?? '';
  const demoUsername = root?.dataset.demo ?? '';

  // tiny escape helper
  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  const icon = (name: string, size = 16): string =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS[name] ? ICON_PATHS[name].split(' ').map((d: string) => `<path d="${d}"/>`).join('') : ''}</svg>`;

  function animateCount(el: HTMLElement, to: number, format: (n: number) => string) {
    const start = performance.now();
    const dur = 1100;
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / dur);
      const v = to * (1 - Math.pow(2, -10 * t));
      el.textContent = format(t === 1 ? to : v);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function renderSkeleton() {
    root!.innerHTML = `
      <div class="gh-skeleton" aria-busy="true" aria-label="Loading GitHub data">
        <div class="skeleton" style="height:132px;border-radius:22px"></div>
        <div class="gh-skel-row">
          ${'<div class="skeleton"></div>'.repeat(6)}
        </div>
      </div>`;
  }

  function renderEmpty() {
    root!.innerHTML = `
      <div class="gh-state glass">
        <div class="gh-state__orb">${icon('github', 24)}</div>
        <h3>GitHub data is waiting for a username</h3>
        <p>Set <code>github.username</code> in <code>src/config/site.ts</code> and this
        panel will light up with live stats — stars, activity, repositories and more.</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
          <button class="btn btn--ghost btn--sm" id="gh-demo">Load sample account</button>
          <a class="btn btn--primary btn--sm" href="https://github.com/settings/profile" target="_blank" rel="noopener">Find my username</a>
        </div>
      </div>`;
    root!.querySelector('#gh-demo')?.addEventListener('click', () => init(demoUsername));
  }

  function renderError(message: string) {
    root!.innerHTML = `
      <div class="gh-state glass">
        <div class="gh-state__orb" style="background:linear-gradient(120deg,#f59e0b,#ef4444)">${icon('refresh', 22)}</div>
        <h3>Couldn't reach GitHub</h3>
        <p>${esc(message)} — GitHub's public API rate limit may be exhausted.
        Try again in a minute, or set <code>PUBLIC_GITHUB_TOKEN</code> for a higher limit.</p>
        <button class="btn btn--primary btn--sm" id="gh-retry">Try again</button>
      </div>`;
    root!.querySelector('#gh-retry')?.addEventListener('click', () => init());
  }

  function render(data: GithubData, fromCache: boolean) {
    const p = data.profile;
    const avatar = p.avatarUrl || `https://github.com/${encodeURIComponent(p.login)}.png?size=200`;
    const accountAge = Math.max(0, (Date.now() - new Date(p.createdAt).getTime()) / (365.25 * 86400000));

    const heat =
      data.contributions && data.contributions.days.length > 0
        ? `<div class="gh-streaks">
             <span class="chip chip--accent">🔥 ${formatNumber(data.contributions.total)} contributions · 12 mo</span>
             <span class="chip">Current streak ${data.contributions.currentStreak}d</span>
             <span class="chip">Longest streak ${data.contributions.longestStreak}d</span>
           </div>
           <div class="gh-heatmap" role="img" aria-label="Contribution heatmap of the last year">
             ${data.contributions.days.map((d) => `<span class="heat-cell heat-${d.level}" title="${esc(d.date)} — ${d.count} contribution${d.count === 1 ? '' : 's'}"></span>`).join('')}
           </div>`
        : `<p style="font-size:.9rem;color:var(--text-3);line-height:1.6">
             <b style="color:var(--text-2)">Contribution heatmap</b><br/>
             The public API doesn't expose the contribution calendar. Add
             <code>PUBLIC_GITHUB_TOKEN</code> to <code>.env</code> to unlock total
             contributions, streaks and the year heatmap via GitHub's GraphQL API.
           </p>`;

    const langs = data.languages;
    const langMax = Math.max(1, ...langs.map((l) => l.count));

    root!.innerHTML = `
      <div class="gh-profile glass glass--hover">
        <div class="gh-avatar-wrap">
          <img class="gh-avatar" src="${esc(avatar)}" alt="${esc(p.name ?? p.login)} avatar" loading="lazy" width="84" height="84"/>
        </div>
        <div class="gh-id">
          <h3>${esc(p.name ?? p.login)} <a class="gh-login" href="${esc(p.htmlUrl)}" target="_blank" rel="noopener">@${esc(p.login)} ${icon('external', 13)}</a></h3>
          ${p.bio ? `<p class="gh-bio">${esc(p.bio)}</p>` : ''}
          <div class="gh-meta">
            ${p.location ? `<span class="chip">📍 ${esc(p.location)}</span>` : ''}
            <span class="chip">👤 ${formatNumber(p.followers)} followers</span>
            <span class="chip">🕐 ${accountAge.toFixed(1)} yrs on GitHub</span>
          </div>
        </div>
      </div>

      <div class="gh-metrics">
        <div class="gh-metric glass"><span class="value" data-count>0</span><span class="label">Stars earned</span></div>
        <div class="gh-metric glass"><span class="value" data-count>0</span><span class="label">Forks</span></div>
        <div class="gh-metric glass"><span class="value" data-count>0</span><span class="label">Followers</span></div>
        <div class="gh-metric glass"><span class="value" data-count>0</span><span class="label">Public repos</span></div>
        <div class="gh-metric glass"><span class="value" data-count>0</span><span class="label">Public commits</span></div>
        <div class="gh-metric glass"><span class="value" data-count>0</span><span class="label">Last activity</span></div>
      </div>

      <div class="gh-panels">
        <div class="gh-panel glass">
          <h4>${icon('star', 16)} Most starred</h4>
          ${data.topRepos.length ? data.topRepos.map((r) => `
            <div class="gh-repo">
              <div class="gh-repo__top">
                <span class="lang-dot" style="background:${languageColor(r.language)}"></span>
                <a class="gh-repo__name" href="${esc(r.htmlUrl)}" target="_blank" rel="noopener">${esc(r.name)}</a>
              </div>
              ${r.description ? `<p class="gh-repo__desc">${esc(r.description)}</p>` : ''}
              <div class="gh-repo__meta">
                ${r.language ? `<span><span class="lang-dot" style="background:${languageColor(r.language)}"></span>${esc(r.language)}</span>` : ''}
                <span>${icon('star', 12)} ${formatCompact(r.stars)}</span>
                <span>${icon('fork', 12)} ${formatCompact(r.forks)}</span>
              </div>
            </div>`).join('') : `<p class="gh-empty-events">No public repositories yet.</p>`}
        </div>

        <div class="gh-panel glass">
          <h4>${icon('activity', 16)} Recent activity</h4>
          ${data.events.length ? data.events.slice(0, 7).map((e) => `
            <div class="gh-event">
              <span class="gh-event__icon">${icon(eventIcon(e.type), 14)}</span>
              <div class="gh-event__body">
                <p class="gh-event__text">${esc(e.description)} <b>${esc(e.repo)}</b></p>
                <p class="gh-event__time">${timeAgo(e.createdAt)}${e.action ? ` · ${esc(e.action)}` : ''}</p>
              </div>
            </div>`).join('') : `<p class="gh-empty-events">No public activity in the last 90 days.</p>`}
        </div>
      </div>

      <div class="gh-panels">
        <div class="gh-panel glass">
          <h4>${icon('layers', 16)} Language mix</h4>
          <div class="gh-lang">
            ${langs.length ? langs.map((l) => `
              <div class="gh-lang__row">
                <span class="gh-lang__name"><span class="lang-dot" style="background:${languageColor(l.name)}"></span>${esc(l.name)}</span>
                <span class="gh-lang__bar"><i style="width:${Math.round((l.count / langMax) * 100)}%"></i></span>
                <span class="gh-lang__count">${l.count}</span>
              </div>`).join('') : `<p class="gh-empty-events">No language data yet.</p>`}
          </div>
        </div>

        <div class="gh-panel glass">
          <h4>${icon('flame', 16)} Contributions</h4>
          ${heat}
        </div>
      </div>

      <div class="gh-foot">
        <span>${fromCache ? 'Cached — ' : ''}Fetched live from api.github.com${data.lastActivity ? ` · last activity ${timeAgo(data.lastActivity)}` : ''}</span>
        <button class="btn btn--ghost btn--sm" id="gh-refresh" style="padding:6px 14px">${icon('refresh', 13)} Refresh</button>
      </div>`;

    // animate metric counters
    root!.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const key = el.parentElement!.querySelector('.label')!.textContent!;
      const map: Record<string, number> = {
        'Stars earned': data.starsTotal,
        Forks: data.forksTotal,
        Followers: p.followers,
        'Public repos': p.publicRepos,
        'Public commits': data.totalCommits ?? 0,
      };
      if (key === 'Last activity') {
        el.textContent = data.lastActivity ? timeAgo(data.lastActivity) : '—';
      } else {
        animateCount(el, map[key] ?? 0, formatNumber);
      }
    });

    root!.querySelector('#gh-refresh')?.addEventListener('click', () => {
      localStorage.removeItem('nova:github:v2');
      init();
    });
  }

  async function init(customUsername?: string) {
    if (!root) return;
    const user = customUsername || username;
    if (!user || user.startsWith('[')) {
      renderEmpty();
      return;
    }
    renderSkeleton();
    try {
      const result = await fetchGitHubData(user);
      if (result.data) {
        render(result.data, result.fromCache);
      } else {
        renderError(result.error ?? 'Unknown error');
      }
    } catch (err) {
      renderError(err instanceof Error ? err.message : 'Unknown error');
    }
  }

  let inited = false;
  document.addEventListener('astro:page-load', () => {
    if (inited || !root) return;
    inited = true;
    init();
  });
</script>
