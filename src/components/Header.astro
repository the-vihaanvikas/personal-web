---
import { site, isPlaceholderLink } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';

interface Props {
  active?: string;
}

const { active = '' } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/stats', label: 'Stats' },
  { href: '/contact', label: 'Contact' },
];
---

<header id="site-header" class="site-header" transition:persist="site-header">
  <div class="container">
    <div class="nav-shell glass">
      <a class="brand" href="/" aria-label="Home">
        <span class="brand__orb" aria-hidden="true"></span>
        <span class="brand__name">{site.name}</span>
      </a>

      <nav class="nav-desktop" aria-label="Primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', active === item.href && 'is-active']}
            aria-current={active === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="nav-actions">
        {!isPlaceholderLink(site.socials.github) && (
          <a
            class="nav-icon-link"
            href={site.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
            title="GitHub"
          >
            <Icon name="github" size={17} />
          </a>
        )}
        <ThemeToggle />
        <button
          id="nav-toggle"
          class="nav-burger"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <nav id="nav-menu" class="nav-mobile glass" aria-label="Mobile">
      {nav.map((item, i) => (
        <a
          href={item.href}
          class:list={['nav-mobile__link', active === item.href && 'is-active']}
          style={`--i:${i}`}
        >
          <span class="nav-mobile__index">0{i + 1}</span>
          {item.label}
        </a>
      ))}
      <div class="nav-mobile__footer">
        <a href={site.socials.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <a href={`mailto:${site.email}`}>Email</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding-top: 12px;
    transition: padding-top var(--dur-med) var(--ease-out);
  }

  .site-header.is-scrolled {
    padding-top: 6px;
  }

  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 10px 8px 18px;
    border-radius: var(--r-pill);
    background: var(--glass-bg);
    transition:
      background var(--dur-med) ease,
      box-shadow var(--dur-med) ease,
      border-color var(--dur-med) ease;
  }

  .site-header.is-scrolled .nav-shell {
    background: var(--glass-bg-2);
    box-shadow: var(--glass-shadow), inset 0 1px 0 var(--glass-highlight);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 640;
    letter-spacing: -0.02em;
    font-size: 0.98rem;
    padding: 4px 2px;
  }

  .brand__orb {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #fff, var(--accent) 38%, var(--accent-2) 78%);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 65%, transparent);
    flex: none;
  }

  .nav-desktop {
    display: flex;
    gap: 2px;
  }

  .nav-link {
    position: relative;
    padding: 7px 13px;
    border-radius: var(--r-pill);
    font-size: 0.9rem;
    font-weight: 520;
    color: var(--text-2);
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .nav-link:hover {
    color: var(--text-1);
    background: var(--glass-bg-2);
  }

  .nav-link.is-active {
    color: var(--text-1);
    font-weight: 600;
    background: var(--glass-bg-2);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-icon-link {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--text-2);
    background: var(--glass-bg-2);
    border: 1px solid var(--glass-border-2);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .nav-icon-link:hover {
    color: var(--text-1);
    border-color: var(--glass-border);
    transform: translateY(-1px);
  }

  .nav-burger {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    place-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: var(--glass-bg-2);
    border: 1px solid var(--glass-border-2);
  }

  .nav-burger span {
    width: 15px;
    height: 1.6px;
    border-radius: 2px;
    background: var(--text-1);
    transition: transform 0.35s var(--ease-out), opacity 0.2s ease;
  }

  .nav-burger.is-active span:nth-child(1) {
    transform: translateY(5.6px) rotate(45deg);
  }
  .nav-burger.is-active span:nth-child(2) {
    opacity: 0;
  }
  .nav-burger.is-active span:nth-child(3) {
    transform: translateY(-5.6px) rotate(-45deg);
  }

  .nav-mobile {
    display: none;
    margin-top: 10px;
    padding: 12px;
    border-radius: var(--r-lg);
    background: var(--glass-bg-2);
  }

  .nav-mobile.open {
    display: block;
    animation: menu-in 0.35s var(--ease-out) both;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.99);
    }
  }

  .nav-mobile__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 14px;
    border-radius: var(--r-md);
    font-weight: 560;
    color: var(--text-1);
    opacity: 0;
    animation: link-in 0.4s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 40ms + 60ms);
  }

  .nav-mobile.open .nav-mobile__link {
    opacity: 1;
  }

  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  .nav-mobile__link.is-active {
    background: var(--grad-accent-soft);
  }

  .nav-mobile__index {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: 0.1em;
  }

  .nav-mobile__footer {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    padding: 12px 14px 4px;
    border-top: 1px solid var(--glass-border-2);
    font-size: 0.88rem;
    color: var(--text-2);
  }

  .nav-mobile__footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 880px) {
    .nav-desktop {
      display: none;
    }

    .nav-burger {
      display: inline-flex;
    }
  }

  @media (max-width: 420px) {
    .brand__name {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-mobile.open .nav-mobile__link {
      animation: none;
    }
  }
</style>
