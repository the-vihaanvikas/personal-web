---
import { site } from '../config/site';

interface Props {
  size?: number;
  class?: string;
}

const { size = 120, class: className } = Astro.props;
const initials = site.initials === '[INITIALS]' ? '?' : site.initials.slice(0, 2);
---

<div
  class:list={['avatar', className]}
  style={`--avatar-size:${size}px`}
  aria-hidden="true"
>
  <span>{initials}</span>
</div>

<style>
  .avatar {
    --avatar-size: 120px;
    position: relative;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.9), transparent 42%),
      var(--grad-accent);
    box-shadow:
      0 18px 40px -14px color-mix(in srgb, var(--accent) 55%, transparent),
      inset 0 2px 6px rgba(255, 255, 255, 0.45);
  }

  .avatar::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    z-index: -1;
  }

  .avatar span {
    font-size: calc(var(--avatar-size) * 0.34);
    font-weight: 620;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 0 1px 4px rgba(20, 20, 60, 0.35);
  }
</style>
